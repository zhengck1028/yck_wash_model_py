# ── 敏感信息（绝不提交）──
.env
.env.local
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 虚拟环境 ──
.venv/
venv/
env/

# ── 数据迁移 / 临时产物 ──
_migration/
*.sql.bak
*.csv
preview_*.csv
# 工具产出的 id 清单/数据文件（如 ids.txt / dirty_autohome_ids.txt）
tools/*.txt

# ── 日志 ──
*.log
logs/

# ── Airflow 运行时（NAS 上生成，不入库）──
airflow_logs/
airflow_pgdata/

# ── IDE / 编辑器 ──
.vscode/
.idea/
*.swp
.DS_Store
