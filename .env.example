# 环境变量模板 —— 复制为 .env 后填入真实值
# .env 已在 .gitignore，不会提交。生产部署用容器环境变量注入。
# 下方 host/user/库名均为占位示例，请按实际环境填写。

# ── 爬虫库（数据源）──
DB_LOCAL_HOST=
DB_LOCAL_PORT=3306
DB_LOCAL_USER=
DB_LOCAL_PASS=
DB_LOCAL_NAME=yck-data-center

# ── ODS 中间层 ──
DB_ODS_HOST=
DB_ODS_PORT=3306
DB_ODS_USER=
DB_ODS_PASS=
DB_ODS_NAME=yck_ods

# ── IT 云端生产库（最终写入目标）──
DB_IT_HOST=
DB_IT_PORT=3306
DB_IT_USER=
DB_IT_PASS=
DB_IT_NAME=yck

# ── 阿里云数据中台（已废弃，仅历史模块引用）──
DB_YUN_HOST=
DB_YUN_PORT=3306
DB_YUN_USER=
DB_YUN_PASS=
DB_YUN_NAME=

# ── 其余库（按需）──
DB_IT_TEST_HOST=
DB_IT_TEST_PASS=
DB_VDB_HOST=
DB_VDB_USER=
DB_VDB_PASS=
DB_VDB_NAME=generalcardb

# ── 邮件告警 ──
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ── Airflow 部署（仅 NAS docker-compose 用）──
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_UID=1000
